#!/usr/bin/env bash
set -Eeuo pipefail
units=(fcv-stack.target fcv-xrce.service fcv-telemetry.service fcv-runtime.service fcv-health.service)
stop_stack() {
  sudo systemctl stop fcv-stack.target fcv-runtime.service fcv-telemetry.service fcv-health.service fcv-xrce.service
  rm -f /tmp/fcv_system_status.json
}
case "${1:-}" in
  status)
    systemctl status --no-pager "${units[@]}" || true
    if systemctl is-active --quiet fcv-stack.target && [[ -f /tmp/fcv_system_status.json ]]; then
      cat /tmp/fcv_system_status.json
    fi
    ;;
  start) sudo systemctl start fcv-stack.target ;;
  stop) stop_stack ;;
  restart)
    stop_stack
    sudo systemctl start fcv-stack.target
    ;;
  logs) shift; exec journalctl --no-pager -u fcv-xrce.service -u fcv-telemetry.service -u fcv-runtime.service -u fcv-health.service "$@" ;;
  xrce|vision|gateway)
    case "$1" in xrce) unit=fcv-xrce.service;; *) unit=fcv-runtime.service;; esac
    exec journalctl --no-pager -u "$unit" -n 80
    ;;
  check)
    set -a
    source /etc/fcv/fcv.env
    set +a
    set +u
    source "$REPO/scripts/env_rk3576.sh"
    set -u
    exec /usr/bin/python3 "$REPO/scripts/fcv_boot.py" check
    ;;
  *) echo 'usage: fcvctl {status|start|stop|restart|logs|vision|gateway|xrce|check}' >&2; exit 2 ;;
esac
